{
  "name": "gladys-nettleie",
  "version": "0.1.0",
  "private": true,
  "description": "Norwegian grid tariffs (nettleie) for Gladys Assistant: energy part and capacity steps of every grid company from the fri-nettleie data (CC BY 4.0), consumption tax, Enova and VAT by zone, optional spot price with strømstøtte or Norgespris, as a delegated energy contract.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-timeout=60000",
    "audit": "npm audit --omit=dev",
    "cover": "node scripts/cover.mjs cover.png"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-nettleie.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "license": "Apache-2.0"
}
